# syntax=docker/dockerfile:1
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY pom.xml ./
COPY src ./src
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -DskipTests package \
    && set -- target/*.jar \
    && test "$#" -eq 1 \
    && cp "$1" /secure-service.jar

FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
COPY --from=build /secure-service.jar ./secure-service.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/secure-service.jar"]
